---
import { text, primaryUrl, type Home, type RecordData } from '../lib/cms';
import { ui } from '../i18n/ui';
import Media from './Media.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import AiDemo from './AiDemo';
interface Props { home: Home; section: RecordData; }
const { home: h, section: s } = Astro.props;
const key = s.key;
const hero = h.hero;
const headline = text(hero.headline);
const highlight = text(hero.highlighted_words);
const parts = highlight ? headline.split(highlight) : [headline];
---
{key === 'hero' && <section class="hero" aria-labelledby="hero-heading"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow hero-eyebrow"><span class="little-star">✳</span>{text(hero.eyebrow)}</div><h1 id="hero-heading">{parts.map((part,i)=><>{i > 0 && <span class="accent-text">{highlight}</span>}{part}</>)}</h1><p class="hero-description">{text(hero.subheadline)}</p><div class="hero-actions"><a class="button" href={primaryUrl(h.settings)} data-track="hero-cta">{text(hero.primary_cta?.label)}<Icon/></a><a class="button ghost" href={hero.secondary_cta?.url}>{text(hero.secondary_cta?.label)}<Icon/></a></div>{hero.intro_video_url && <a class="intro-link" href={hero.intro_video_url} rel="noopener noreferrer">{ui.intro}<Icon size={16}/></a>}<p class="script-tagline">{text(hero.script_tagline)}</p></div><div class="hero-art">{hero.background_image?.src ? <Media image={hero.background_image} eager/> : <><div class="halo"></div>{h.settings.logo_dark?.src && <img src={h.settings.logo_dark.src} width="540" height="540" alt="" fetchpriority="high"/>}<div class="art-corner corner-top"></div><div class="art-corner corner-bottom"></div></>}</div></div><div class="container hero-rule"><span></span><span>{text(h.settings.tagline)}</span><span></span></div></section>}
{key === 'stats' && <section class="container stats" aria-label={text(s.title)}>{h.stats.map(stat=><div><strong>{stat.value}</strong><span>{text(stat.label)}</span>{text(stat.sublabel)&&<small>{text(stat.sublabel)}</small>}</div>)}</section>}
{!['navbar','hero','stats','footer','cta'].includes(key) && <section id={key} class:list={['section',`section-${key}`]} aria-labelledby={`${key}-heading`}><div class="container"><div class="section-header"><div><p class="eyebrow">{text(s.eyebrow)}</p><h2 id={`${key}-heading`}>{text(s.title)}</h2>{text(s.subtitle) && <p class="section-subtitle">{text(s.subtitle)}</p>}</div>{s.cta?.url && <a class="button ghost button-small" href={s.cta.url}>{text(s.cta.label)}<Icon size={16}/></a>}</div>
  {key==='projects' && <><div class="projects-grid">{h.projects.map((p,i)=><ProjectCard project={p} index={i}/>)}</div><div class="mid-cta"><span>{text(h.settings.contact_title)}</span><a href={primaryUrl(h.settings)} data-track="projects-cta">{text(h.settings.primary_cta?.label)}<Icon size={16}/></a></div></>}
  {key==='ai' && <AiDemo client:visible config={h.ai} sitekey={h.turnstile_site_key} name={h.settings.brand_name}/> }
  {key==='services' && <div class="services-grid">{h.services.map(service=><article class="service-card"><div class="icon-box"><Icon name={service.icon} size={24}/></div><h3>{text(service.title)}</h3><p>{text(service.description)}</p><ul>{service.bullets?.map((b: {id:string})=><li><Icon name="check" size={15}/>{text(b)}</li>)}</ul></article>)}</div>}
  {key==='process' && <ol class="process-grid">{h.process.map(step=><li><span class="step-number">{step.number}</span><h3>{text(step.title)}</h3><p>{text(step.description)}</p></li>)}</ol>}
  {key==='about' && <div class="about-grid"><div class="about-visual">{h.about.photo?.src ? <Media image={h.about.photo}/> : <div class="about-monogram" aria-hidden="true">{h.about.name?.split(' ').map((n:string)=>n[0]).slice(0,2).join('')}<span>{h.settings.brand_name}</span></div>}<div class="about-name"><h3>{h.about.name}</h3><p>{text(h.about.role)}</p></div></div><div class="about-copy"><div class="prose" set:html={h.about.bio_html?.id}/><div class="highlights">{h.about.highlight_cards?.map((card: RecordData)=><div><span class="tiny-square"></span><h3>{text(card.title)}</h3><p>{text(card.description)}</p></div>)}</div><div class="tech-list">{h.tech.map(tech=><span>{tech.image?.src && <Media image={tech.image}/>}<Icon name={tech.icon} size={16}/>{tech.name}</span>)}</div></div></div>}
  {key==='articles' && <div class="articles-grid">{h.articles.slice(0,4).map(article=><article class="article-card"><Media image={article.cover}/><span class="eyebrow">{text(article.category)}</span><h3><a href={`/articles/${article.slug}`}>{text(article.title)}</a></h3><p>{text(article.excerpt)}</p><a href={`/articles/${article.slug}`} class="text-link">{ui.read}<Icon size={16}/></a></article>)}</div>}
  {key==='pricing' && <><div class="pricing-grid">{h.pricing.map(p=><article class:list={['price-card',p.highlighted&&'highlighted']}><h3>{text(p.name)}</h3><strong>{text(p.price_text)}</strong><p>{text(p.description)}</p><ul>{p.features?.map((f: {id:string})=><li><Icon name="check" size={16}/>{text(f)}</li>)}</ul><a class="button" href={p.cta?.url || primaryUrl(h.settings)} data-track="package-cta">{text(p.cta?.label)}<Icon size={16}/></a></article>)}</div><div class="mid-cta"><span>{text(h.settings.contact_title)}</span><a href={primaryUrl(h.settings)} data-track="pricing-cta">{text(h.settings.primary_cta?.label)}<Icon size={16}/></a></div></>}
  {key==='testimonials' && <div class="testimonials-grid">{h.testimonials.map(t=><figure class="testimonial"><blockquote>{text(t.quote)}</blockquote><figcaption><Media image={t.avatar}/><strong>{t.author_name}</strong><span>{text(t.role)}{t.company && ` · ${t.company}`}</span></figcaption></figure>)}</div>}
  {key==='faq' && <div class="faq-list">{h.faq.map(f=><details><summary>{text(f.question)}<Icon name="plus"/></summary><div class="prose" set:html={f.answer_html?.id}/></details>)}</div>}
</div></section>}
{key==='cta' && <section class="section cta-section"><div class="container"><div class="cta-band"><div><p class="eyebrow">{text(h.settings.tagline)}</p><h2>{text(s.title)}</h2><p>{text(s.subtitle)}</p></div><a class="button" href={primaryUrl(h.settings)} data-track="final-cta">{text(h.settings.primary_cta?.label)}<Icon/></a></div></div></section>}
