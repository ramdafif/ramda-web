APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///ramda.sqlite
# Optional schema migration identity; the running services use DATABASE_URL only.
MIGRATION_DATABASE_URL=
SITE_URL=http://localhost:4321
BACKEND_URL=http://127.0.0.1:8000
REVALIDATE_URL=http://127.0.0.1:4321/__revalidate
REVALIDATE_SECRET=
UPLOAD_DIR=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Development only; production always requires successful Turnstile verification.
DEV_ALLOW_UNVERIFIED_FORMS=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_ALLOWED_MODELS=
AI_API_KEY=
AI_DAILY_BUDGET_USD=1
# Set current actual provider prices before enabling the demo.
AI_INPUT_USD_PER_MILLION=1
AI_OUTPUT_USD_PER_MILLION=4
TOTP_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
# Exact origin, also allowed by the public CSP. Match the CMS analytics URL.
ANALYTICS_ORIGIN=

BACKUP_RETENTION_DAYS=14
